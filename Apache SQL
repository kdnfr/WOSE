    	               </tr>
    	               <tr>
        	                <td><button onclick="changeLog(9)">quitter</button></td>
        	                <td><button onclick="changeLog(3)">validez</button></td>
    	               </tr>
	                </table>' ;
	else
	
	end ;

	Return csconvert(lHTML, 'UTF-8') ;
