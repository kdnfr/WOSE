editingMode = false ;

function editorRWMode(t) {
	if(t == 1) {
	    editingMode=!editingMode
	} else if(t==2) {
	    editingMode=true ;
	} else if(t < 0) {
	    editingMode=false ;
	} 
	
	url="?a={requestFileRW}&editingMode="+(editingMode?1:0)+"&codeDoc="+lCodeDoc+"&codeProjet="+lCodeProject
    ajax(url, function(v){
    	if(v>0 && v<9) {
            modeRW.classList.remove("divHidden")
            $("#editorModeRW button").innerText = "R/W"
            $("#editorOpenedBy").innerText = "opened by {sessionUID}"
            editorModeRW.style.color="lime"
            editor.setOptions({
        	    readOnly: false,
        	    highlightActiveLine: true,
        	    highlightGutterLine: true
        	})
        	editor.renderer.$cursorLayer.element.style.opacity=1
        	editor.textInput.getElement().disabled=false
        } else {
            modeRW.classList.add("divHidden")
            $("#editorModeRW button").innerText = "R/O"
            editorModeRW.style.color="red"
            editor.setOptions({
        	    readOnly: true,
        	    highlightActiveLine: false,
        	    highlightGutterLine: false
        	})
        	editor.renderer.$cursorLayer.element.style.opacity=0
        	editor.textInput.getElement().disabled=true
        }
        refreshListe()
    })
    
}

document.onkeydown = function() {
	kc=event.keyCode ;

	if(event.ctrlKey && kc===113) {
	    editorRWMode(1)
	}
	if(event.ctrlKey && kc===83) {
		event.preventDefault() ;
		event.stopPropagation() ;
		saveData({saveDoc}) ;
	}

	if(kc===86 && event.ctrlKey && event.shiftKey==false && editoCopiedValue!="") {
		event.preventDefault() ;
		event.stopPropagation() ;
		editor.insert("{"+editoCopiedValue+"}") ;
	}

	if(kc==114 ) {
		event.preventDefault() ;
		event.stopPropagation() ;
		if(event.shiftKey==0) {
			findNext()
		} else {
			findPrevious()
		}
	} else if(kc==115 ) {
		event.preventDefault() ;
		event.stopPropagation() ;
		if(event.shiftKey) {
			editor.insert(editoCopiedValue) ;
			editoCopiedValue="" ;
		} else {
			sel = editor.getSelectedText()
			ajax("?a=501&tableName="+sel, function(v){alerter(v)}) ;
		}
	} else if(kc==116) {
		event.preventDefault() ;
		event.stopPropagation() ;
	} else if(kc==120) {
		saveData({executeDoc})
	}

}

document.onkeyup= function() {
	kc=event.keyCode ;
	if(event.ctrlKey && kc===70) {
		event.preventDefault() ;
		event.stopPropagation() ;
		findNext();
	}
	if(event.ctrlKey && kc===83) {
		event.preventDefault() ;
		event.stopPropagation() ;
	}

	if(kc===86 && event.ctrlKey && event.shiftKey==false && editoCopiedValue!="") {
		event.preventDefault() ;
		event.stopPropagation() ;
		editoCopiedValue="" ;
	}

	if(kc==114) {
		event.preventDefault() ;
		event.stopPropagation() ;

	} else if(kc==116) {
		event.preventDefault() ;
		event.stopPropagation() ;
	}

}

