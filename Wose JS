function loaderOn() {
    lg = document.createElement("DIV")
    lg.id="loaderGif"
    lg.style="position:fixed;display:block;top:0;left: 0;right: 0;bottom:0;text-align:center;padding-top: 43vh;z-index: 9999999;background: #00000040;"
