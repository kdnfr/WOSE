		compileButton.style.color="white" ;
		ajax(url, function(v){
			compileButton.style.background="" ;
			compileButton.style.color="" ;

			if(v!="1" && v!="0"){
				alerter(v.substr(0, 255))
			} else {
				ACEChanged = 0 ;
				try{saveButton.setAttribute("disabled", true) }catch(err){ };
				if(showSQLForm.checked && v!="0") {
					setTimeout(function(){
						document.getElementById("renderContent").src="./"+lTestURL
					}, 500) ;
					refreshListe();
					refreshRecents()
				}
			}
		} );
	}catch(err){
		alerter(err.description +": document inexistant, si nécessaire veuillez le recréer, en copiant éventuellement son contenu")
	}
}

