var notyText = "" ;

function notifyMe(txt) {
	if (!Notification) return ;
	try{clearTimeout(notyTO)}catch(err){console.log(err.description)} ;
	if (!txt || txt=="")txt="Vous avez une ou plusieurs factures à contrôler ou à valider" ;
	notyText = txt = txt + "<br>"+notyText ;
	if (Notification.permission !== "granted") Notification.requestPermission();
	noty = new Notification("Notification Compta ABEJ", { icon: "abejBigNotif.png", body: txt, tag:"PSCCompta"});
	noty.onclick = function () { window.open("./pscCompta", "pscCompta"); }
	noty.onClose =function(byUser) {console.log(byUser); } ;
	notyTO = setTimeout(function() { noty.close() ; notyText=""}, 60000) ;
}

