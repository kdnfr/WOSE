}

function loaderOff() {
    o=document.querySelector("#loaderGif")
    o.parentElement.removeChild(o)
}

function fullScreen4Me() {
	if(!document.webkitIsFullScreen){
		document.documentElement.webkitRequestFullScreen();
	}else{
		document.webkitCancelFullScreen();
	}
}

