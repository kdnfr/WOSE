var lBlobName = "", lBlobType = "", lBlobCategorie = "", lBlobSize = 0, lBlobSource, lh = 0, lw =  0, lcodeWoseBlob=0, photoIdCode = 0 ; 
function initWindow() {
	document.ondragover = function (event) {event.preventDefault(); return false} ;
	document.ondragenter = function (event) {event.preventDefault(); return false} ;
	document.ondrop = function (event) {
		event.stopPropagation() ;
		event.preventDefault();
		var dt = event.dataTransfer;
		if(dt.files.length>0) {
		    console.log(dt.files)
		    alerter("vous allez dumper "+dt.files.length+" fichiers?")
			var reader = new FileReader();
			reader.onload = function(event) {
				lBlobSource = encodeURIComponent(event.target.result) ;
				var lBlob = lBlobSource.match(/.{1,50000}/g);
				pctAvanceImport.style.width = "1px" ;
				loadingbar.style.display="block";
				saveBlob(lBlob, 0, lCodeDocument) ;
			};
			fn = dt.files[0].name ;
			lBlobName = fn ;
			lBlobType = fn.substr(fn.indexOf(".")+1) ;
			lBlobCategorie = "a classer" ;
			reader.readAsDataURL(dt.files[0]);
		}
	} ;

    document.onpaste = function (event) {
    	var items = (event.clipboardData  || event.originalEvent.clipboardData).items;
    	var blob = null;
    	for (var i = 0; i < items.length; i++) {
    		if (items[i].type.indexOf("image") === 0) {
    			blob = items[i].getAsFile();
    		}
    	}
    
    	if (blob !== null) {
    		var reader = new FileReader();
    		reader.onload = function(event) {
    			var lBlobSource = encodeURIComponent(event.target.result);
    			    	alerter(lBlobSource)

    			var lBlob = lBlobSource.match(/.{1,50000}/g);
    			pctAvanceImport.style.width = "1px" ;
    			loadingbar.style.display="block";
    			//saveBlob(lBlob, 0, lCodeDocument)   ;
    		};
    		reader.readAsDataURL(blob);
    	}

    }
}

var tl=0 ;
function saveBlob(blk, ndx, icode) {
	if(!ndx)ndx=0;
	if(!icode)icode=0;
	wd = parseInt(100*ndx/blk.length) ;
	pctAvanceImport.style.width = wd + "%" ;
	if(ndx==0){
		lURL = "./apacheSQL?a={saveBlobIni}&imgCode="+icode+"&imgIndex="+ndx+"&imgSrc="+escape(blk[ndx])+"&imgType="+lBlobType+"&imgName="+escape(lBlobName) ;

	} else if(ndx<blk.length) {
		lURL = "./apacheSQL?a={saveBlobCpl}&imgCode="+icode+"&imgIndex="+ndx+"&imgSrc="+escape(blk[ndx])+"&imgType="+lBlobType+"&imgName="+escape(lBlobName) ;
	} ;
	ajax(lURL, function(v) {
			ndx+=1;
			if(ndx<blk.length) {
				tl += blk[ndx].length ;
				saveBlob(blk, ndx++, parseInt(v)) ;
			} else {

				lURL = "./apacheSQL?a={saveBlobEnd}&imgCode="+icode+"&imgIndex="+ndx+"&imgType="+lBlobType+"&codeDocument="+lCodeDocument+"&imgName="+escape(lBlobName) ;
				ajax(lURL, function(v){
						try{formPiecesJointes.innerHTML = v }catch(err){ };
					}) ;
				loadingbar.style.display="none";
			}
		}
	);
}
