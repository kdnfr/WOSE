	url = "./woseDoc?a={getSource}&gfs="+gfs+"&docname="+lDocName+"&brouillon="+c+"&codedoc="+lCodeDoc+"&testURL="+escape(t) ;
console.log("lTypeDoc=",lTypeDoc);
	editorTitle.innerText="loading... please wait" ;
	ajax(url, function(v){
	    recordRW=v.split("|")[0]
	    console.log("openDoc.RW="+recordRW)
	    var nx = v.indexOf("|")
	    if(nx>-1 && nx<5) v=v.substr(nx+1).trim()
	    console.log("editorLoaded ", v.substr(0,10))
		editor.setValue(v, 1);
		if(lTypeDoc=="fun") {
	        $$(".editorMode")[1].checked=true
	        changeMode("sqlserver", "iplastic")
		    //document.querySelectorAll(".editorMode")[1].click()
	    } else if(lTypeDoc=="js" || lTypeDoc=="w3j") {
	        $$(".editorMode")[3].checked=true
	        changeMode("javascript", "iplastic")
		    //document.querySelectorAll(".editorMode")[3].click()
	    } else if(lTypeDoc=="pro" || lTypeDoc=="vie" || lTypeDoc=="ser" || lTypeDoc=="tab" || lTypeDoc=="tri") {
	        $$(".editorMode")[1].checked=true
	        changeMode("sqlserver", "iplastic")
		    //document.querySelectorAll(".editorMode")[1].click()
	    } else if(lTypeDoc=="css" || lTypeDoc=="w3c") {
	        $$(".editorMode")[4].checked=true
	        changeMode("css", "iplastic")
	        //document.querySelectorAll(".editorMode")[4].click()
	    } else {
	        $$(".editorMode")[0].checked=true
	        changeMode("text", "iplastic")
		    //document.querySelectorAll(".editorMode")[0].click()
        }
		//changeMode('sqlserver', 'iplastic') ;
		if(t && t!="") {
			if(lastTestURL != lTestURL ) {
				lastTestURL = lTestURL ;
				if(showSQLForm.checked && lTestURL>"") document.getElementById("renderContent").src="./"+lTestURL ;
			}
		} ;
		editor.session.getUndoManager().reset() ;
		editorValue = editor.getValue() ;
		editorSource = 0 ;
		ACEChanged=0 ;
		try{saveButton.setAttribute("disabled", true) }catch(err){ }
		if(rechercheEtendue.checked || rechercheProjet.checked) {
			$("#editorSearch").val(lFiltreDocuments) ;
			$("#editorSearch").click()
			lFindCount = editor.findAll(lFiltreDocuments) ;
			findCount.innerText=lFindCount ;
		}
		
		url = "./woseDoc?a={getVersion}&codedoc="+lCodeDoc ;
		ajax(url, function(v){
			//$("#documentSource").innerHTML = v;
			$("#editorTitle").innerHTML = v;
			loadConstants(lCodeDoc) ;
		}) ;
		editorFocus() ;
		try{cback()}catch(err){ }
	} ) ;
	try{cback()}catch(err){ }
}



function editorFocus() {
	setTimeout(
		function(){
    		editorSearch(1)
    		

    		ajax("./woseDoc?a={getEditorContext}&codedoc="+lCodeDoc, function(v){
    			console.log("openwoseDoc.loadContext.val="+v)
    			w=v.split(",");
    			var r=w[0] ;
    			var c=w[1] ;
    			var sr=w[2] ;
    			var sc=w[3] ;
    			var er=w[4] ;
    			var ec=w[5] ;
    			var m =w[6];
    			editor.renderer.scrollCursorIntoView({row:r, column:c});
    			editor.selection.setSelectionAnchor(sr, sc);
    			editor.selection.selectTo(er, ec);
    			editor.moveCursorTo(sr, sc) ;
    			setTimeout(function(){
        			try{
            			$("#editor > .ace_scrollbar-v").scrollTop = w[7];
            			$("#editor > .ace_scrollbar-h").scrollLeft= w[8];
        			} catch(er){ } 
        			refreshFindCount()
    			}, 100)
    			editor.focus();
    		}) ;
		    if(recordRW==1){editorRWMode(2)} else {editorRWMode(-1)}
	}, 100) ;
}


