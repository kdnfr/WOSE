function refreshProjet() {
	try{
		code=projectList.childNodes[0].getAttribute("code") ;
		n=projectList.childNodes[0].id ;
		if(code==null) {
			loadProjets()
		} else {
			var url = "./wosedoc?a={loadProjectFiles}&codedoc="+code+"&docname="+n ;
			console.log("wosedocJS.refreshProjet.url="+url)
			$("#projectList").ajax(url, function(v){$("#actualProjectFiles").innerHTML=v;}) ;
		}
	}catch(err){
		loadProjets()
	}
}

function loadProjets() {
	if(lCodeProject>0) {
	    confirmer("cloturer le projet "+lProjectName+" ?<br><br><i>Ceci rendra les modules disponibles </i><br>Annulez si vous voulez y revenir", function(){
	        console.log("cloturer")
        	url="?a={closeOpenProjectFiles}&codeProjet="+lCodeProject
        	ajax(url, function(v){
            	url="?a={loadProjets}";
            	$("#projectList").ajax(url, function(v){$("#actualProjectFiles").innerHTML=v}) ;
        	})
	    }, function(){
	        console.log("laisser bloqué")
        	url="?a={loadProjets}";
        	$("#projectList").ajax(url, function(v){$("#actualProjectFiles").innerHTML=v}) ;
	        
	    })
	} else {
        console.log("laisser bloqué")
        url="?a={loadProjets}";
        $("#projectList").ajax(url, function(v){$("#actualProjectFiles").innerHTML=v}) ;

	}
}

function openProject(cd, n, c) {
	lCodeProject=cd ;
	lProjectName=n;
	url="?a={loadProjectFiles}&codedoc="+cd+"&docname="+n ;
	$("#projectList").ajax(url, function(v) {
		$("#actualProjectFiles").innerHTML=v;
		$("#actualProjectFiles > ul > span").classList.add("liSelected")
		editorDocMode=1
		url="./woseDoc?a={openProjectDescription}&codeDoc="+lCodeProject ;
		ajax(url, function(v){
			editor.setValue(v, 1);
			changeMode("text", "iplastic") ;
			editor.session.getUndoManager().reset() ;
			editorValue = editor.getValue() ;
			editorSource = 0 ;
			ACEChanged=0 ;
			try{compileButton.style.color="white"}catch(err){ } ;
			$("#projectList >ul >span").classList.add("liSelected")
			url="?a={getProjectVersion}&codedoc="+lCodeProject;
			$("#editorTitle").ajax(url, function(v) {
				try{saveButton.setAttribute("disabled", true) }catch(err){console.log(err)};
			} ) ;
		} ) ;
	} ) ;
	$("#iSQLContent").src="iSQL?startDocName="+n ;
}

