function saveData(la) {
	if (editorDocMode == 1) { 
		url="./woseDoc?a={saveProjectDescription}&codedoc="+lCodeProject+"&source="+encodeURIComponent(editor.getValue()).replace(" ", "+") ;
		ajax(url) ;
