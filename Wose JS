function modalDialogKeyUp(){
    //console.log("modalDialogKeyUp.kc=",event.keyCode)
    if (event.keyCode==27) try{alerterCancel.click();modalDialogCancel()}catch(er){closeModalDialog()} ;
    if (event.keyCode==13) { 
        try{alerterOK.click();}catch(er){ }
        try{modalDialogOK()}catch(er){closeModalDialog()} ;
    }
}

var modalDialogCancel, modalDialogOK ;
function alerter(msg, cback) {
    odb = createDialogBox()
    obj = $("#modalDialogFooter")
	if(!cback) cback=closeModalDialog ;
	modalDialogCancel=modalDialogOK=cback ;
    if(msg.toLowerCase().indexOf("<button")<0) {
      	var btn = document.createElement("button") ;
    	btn.className = "modalDialogButton modalDialogButtonPrincipal" ;
    	btn.id = "alerterOK" ;
    	btn.innerHTML = "OK" ;
    	btn.addEventListener("click", cback, false) ;
    	obj.appendChild(btn);
    } else {
        obj.style.display="none"
    }
	confirmOK = cback ;
	confirmCancel = cback ;
	modalDialogPreemption = 1 ;

	$("#modalDialogContent").html(msg) ;
	$("#__modalDialogBox").className = "mdbShow" ;
	try{$("#alerterOK").focus()}catch(er){ }
}

function confirmer(msg, cback, cbackNo, cbackCancel, options) {
	odb = createDialogBox(cbackCancel)
    obj = $("#modalDialogFooter")
	var btn1 = "OK", btn2="Annuler", btn3="" ;
	if(cbackCancel) {var btn1 = "Oui", btn2="Non", btn3="Annuler"} ;
	if(options) {
		try{btn1=JSON.parse(options).btn1}catch(err){btn1=options.btn1};
		try{btn2=JSON.parse(options).btn2}catch(err){btn2=options.btn2};
		try{btn3=JSON.parse(options).btn3}catch(err){btn3=options.btn3};
	}

	if(msg.toLowerCase().indexOf("<button")<0) {
    
    	if(cbackCancel) {
    		var btn = document.createElement("button") ;
    		btn.className = "modalDialogButton modalDialogButtonPrincipal" ;
    		btn.innerHTML = btn1 ;
    		btn.addEventListener("click", cback, false) ;
    		btn.addEventListener("click", closeModalDialog, false) ;
    		obj.appendChild(btn);
    
    		var btn = document.createElement("button") ;
    		btn.className = "modalDialogButton" ;
    		btn.innerHTML = btn2 ;
    		btn.addEventListener("click", cbackNo, false) ;
    		btn.addEventListener("click", closeModalDialog, false) ;
    		obj.appendChild(btn);
    
    		var btn = document.createElement("button") ;
    		btn.className = "modalDialogButton" ;
    		btn.innerHTML = btn3 ;
    		btn.addEventListener("click", cbackCancel, false) ;
    		btn.addEventListener("click", closeModalDialog, false) ;
    		obj.appendChild(btn);
    
    		confirmOK = cback ;
    		confirmNo = cbackNo ;
    		confirmCancel = cbackCancel ;

    	} else {
    		var btn = document.createElement("button") ;
    		btn.className = "modalDialogButton" ;
    		btn.innerHTML = btn2 ;
    		btn.addEventListener("click", cbackNo, false) ;
    		btn.addEventListener("click", closeModalDialog, false) ;
    		obj.appendChild(btn);
    
    		var btn = document.createElement("button") ;
    		btn.className = "modalDialogButton modalDialogButtonPrincipal" ;
    		btn.innerHTML = btn1 ;
    		btn.addEventListener("click", cback, false) ;
    		btn.addEventListener("click", closeModalDialog, false) ;
    		obj.appendChild(btn);
    
    		confirmOK = cback ;
    		confirmCancel = cbackNo ;
    	}
    }
	modalDialogCancel = cbackCancel ;
	modalDialogOK = cback ;

	modalDialogPreemption = 1 ;
	$("#modalDialogContent").html(msg) ;
	$("#__modalDialogBox").className = "mdbShow" ;
}

function eviterClick() { window.event.stopPropagation() ; }

function modalDialogReponse(r) {
	window.event.preventDefault() ;
	window.event.stopPropagation() ;
}

function closeModalDialog() {
	if(dontCloseDialog==1) {
		dontCloseDialog=0
	} else {
		removeDialogBox()
	}
	modalDialogPreemption = 0 ;
}

function removeDialogBox(){
    try{
        var o=$("#__modalDialogBox")
		o.parentElement.removeChild(o)
		modalDialogCancel=modalDialogOK=null ;
		$("body").removeEventListener("keydown", modalDialogKeyUp) ;
	} catch(er){ }
}

function modalDialogDefaultReponse(c) {
	alerter(c);
}

function doIHaveToClose() {
	closeModalDialog()
}


