	sqlmsg=(resetMessages.checked)?1:0;

	lTestURL = testURL.value ;
	try{
		$("#lr"+lCodeDoc).setAttribute("testURL", lTestURL) 
	}catch(err){
		$("#lr"+lCodeDoc).forEach(function(o,i) {o.setAttribute("testURL", lTestURL) } ) ;
	};

	try{
		editorValue = editor.getValue() ;
		var url = editor.getValue() ;
		url="./woseDoc?a="+la+"&codedoc="+lCodeDoc+"&docname="+lDocName+"&testURL="+lTestURL+"&sqlmsg="+sqlmsg+"&source="+encodeURIComponent(url).replace(" ", "+") ;
