function chgFile(me) {
	fileName=me.value ;
	if(event.keyCode==13) {
		closeModalDialog() ;
		url="./wosedoc?a=330&codeType="+codeType+"&typeWoseDoc="+typeWoseDoc+"&docName="+fileName ;
		console.log(url)
		ajax(url, function(v){
			lCodeDoc =v;
			setTimeout(function(){openWoseDoc(lCodeDoc, fileName, 0)}, 200) ;
			refreshListe() ;

		});
	}
}

function search(me) {
	try{kc = window.event.keyCode }catch(err){kc=13};
	lFiltreDocuments = me.value.toLowerCase() ;
	$("#editorSearch").value=$("#search").value
	editorSearch(1)
	try{
		oldStyleTag = document.getElementById("servicesStyleTag") ;
		document.head.removeChild(oldStyleTag)
	}catch(err){ };

	if(rechercheEtendue.checked  || rechercheProjet.checked) {
		if(kc==13) {
			refreshListe()
		}
	} else {
		if(lFiltreDocuments!="") {
			myStyleTag = document.createElement("style");
			myStyleTag.id = "servicesStyleTag" ;
			myStyleTag.innerText="#listeIdentites li:not([search*='"+lFiltreDocuments+"']) {display:none !important;}" ;
			myStyleTag.innerText+="#listExternalFiles li:not([search*='"+lFiltreDocuments+"']) {display:none !important;}" ;
			document.head.appendChild(myStyleTag);
		}
	}
	try{kc=event.keyCode;}catch(er){kc=0 };
	if(kc==13 && rechercheDocument.checked) editorFocus()
}


