/*********************************************************************************************************
        Utilitaires :
            Special string manipulations

**********************************************************************************************************/

function left(str, n){
	if (n <= 0)
		return "";
	else if (n > String(str).length)
		return str;
	else
		return String(str).substring(0,n);
}

function right(str, n){
	if (n <= 0)
		return "";
	else if (n > String(str).length)
		return str;
	else {
		var iLen = String(str).length;
		return String(str).substring(iLen, iLen - n);
	}
}

function normalizeSearchString(v) {
	/*œ àáâãäåæçèéêëìíîïñ ðòóôõö ×øùúûüýþßàáâãäåæçèéêëìíîïðñòóôõö÷øùúûüýþÿ */
	return '["'+v.replace(/[àáâãäå]/g,"a").replace(/[èéêë]/g, "e").replace(/[ìíîï]/g, "i").replace(/[òóôõö]/g, "o").replace(/[ùúûü]/g, "u").replace(/[ñ]/g, "n").replace(/[ç]/g, "c").replace(/[ýÿ;]/g, "y").replace(/[œ]/g, "o").replace(/[æ]/g, "a").replace(/[^a-z0-9:]/gi,'","')+'"]' ;
}

function convertString(v) {
    return v.replace(/[àáâãäå]/g,"a").replace(/[èéêë]/g, "e").replace(/[ìíîï]/g, "i").replace(/[òóôõö]/g, "o").replace(/[ùúûü]/g, "u").replace(/[ñ]/g, "n").replace(/[ç]/g, "c").replace(/[ýÿ;]/g, "y").replace(/[œ]/g, "o").replace(/[æ]/g, "a") ;
}
