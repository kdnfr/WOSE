		obj.ajax = function (pUrl, cBack, cErr, cTO) {
			if( pUrl != undefined && pUrl != "" ){
				var myURL = pUrl ;
				var n = pUrl.indexOf("?") ;
				if(n>=0) { var URL = pUrl.substring(n+1,pUrl.length); pUrl = pUrl.substring(0, n); } else { var URL = null } ;
				var xhr=null;
				if(window.XMLHttpRequest) xhr=new XMLHttpRequest();else if (window.ActiveXObject) xhr=new ActiveXObject("Microsoft.XMLHTTP");
				xhr.open("POST", pUrl, true);
				xhr.onreadystatechange=function() {
					if ( xhr.readyState==4 ) {
						var ltemp = xhr.responseText ;
						if (left(ltemp, 5)=="nocx|")alert(ltemp);
						try{obj.html(ltemp)}catch(err){ };
						if(cBack!=undefined) { cBack(ltemp) }
					}
				};

				xhr.onerror = xhr.onabort = function(v) {
					ltemp = "erreur réseau : "+v ;
					if(cBack!=undefined) {cBack(ltemp) }
					try{obj.html(ltemp)}catch(err){ }; 
				};

				xhr.setRequestHeader('Content-Type','application/x-www-form-urlencoded');
				try{xhr.send(URL)}catch(err){cErr("no connection:"+myURL)};
				if(cErr!=undefined) {
					if(cTO==undefined) {cTO=5000} ;
					xhr.timeout = cTO ;
					xhr.ontimeout=function(){
						cErr("timeout : "+myURL)
					}
				}

			} ;
		} ;
	return obj;
}

