/*********************************************************************************************************
	Module to retrieve data from DB directly into a variable, or to push back to a function
	and not via an object 

	Different from previous object related ajaxes !

**********************************************************************************************************/

function ajax(pUrl, cBack, cErr, cTO) {
	if( pUrl != undefined && pUrl != "" ){
		myURL = pUrl ;
		var URL = "" ;
		try{var n = pUrl.indexOf("?") }catch(err){n=-2};
		if(n>0) {
				URL = pUrl.substring(n+1,pUrl.length);
				pUrl = pUrl.substring(0, n);
			}
		var xhr=null;
		if(window.XMLHttpRequest) xhr=new XMLHttpRequest();else if (window.ActiveXObject) xhr=new ActiveXObject("Microsoft.XMLHTTP");
		xhrBusy += 1 ;
		xhr.open("POST", pUrl, true);

		xhr.onerror = xhr.onabort = function() {
			ltemp = "pas de connexion au réseau" ;
			if(cErr!=undefined) cErr(ltemp) ;
			return "" ;
		};

		xhr.onreadystatechange=function() {
			if ( xhr.readyState==4 ) {
				xhrBusy -= 1 ;
				var ltemp = xhr.responseText ;
				if (left(ltemp, 5)=="nocx|")try{reconnect(ltemp)}catch(err){ };
				if (cBack!=undefined) {cBack(ltemp)} else {return ltemp} ;
			} ;
			return "" ;
		}

		xhr.setRequestHeader('Content-Type','application/x-www-form-urlencoded');
		xhr.send(URL) ;
		if(cErr!=undefined) {
			if(cTO==undefined) {cTO=5000} ;
			xhr.timeout = cTO ;
			xhr.ontimeout=function(){
				cErr("timeout : "+myURL)
			}
		}
	} else {
		alert("syntax = ajax(URL [, CallBack] )")
	}
} ;

