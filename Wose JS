var editorUndo ;

function uncheckCompilation() {
	viewCompiled.checked=false ;
	getFromSys.checked=false ;
	if(editorSource>0) {
		editor.setValue(editorValue, 1);
		editor.session.setUndoManager(editorUndo) ;
		editorSource = 0 ;
	} else {
		editorValue = editor.getValue() ;
		editorUndo = editor.session.getUndoManager() ;
	}

}

function loadDocument() {
	if(getFromSys.checked) {
		origin="<span style=\"color:yellow\">compilation sys</span>" ;
		lOrigine = 3
	} else if(viewCompiled.checked) {
		origin="<span style=\"color:lime\">compilation wose</span>";
		lOrigine = 1
	} else {
		origin="<span style=\"color:white\">source wose</span>";
		lOrigine = 0
	}
	$("#origine").innerHTML=origin ;
	if (lOrigine>0) {
		compileButton.style.background="orange" ;
		compileButton.style.color="white" ;
		var url="?a=232&origine="+lOrigine+"&codedoc="+lCodeDoc+"&docname="+lDocName ;
		ajax(url, function(v) {
			editorSource = 1 ;
			editor.setValue(v, 1);
			editor.session.getUndoManager().reset() ;
			compileButton.style.background="" ;
			compileButton.style.color="black" ;
		} )
	} else {
		uncheckCompilation() ;
	}
}

