/*CSS*/

/* woseDocCSS.css */

/*INCLUDE woseDocConstants INCLUDE*/

* {    box-sizing: border-box !important;}
body {
	overflow: hidden;
	font-family:arial,calibri,verdana;
}

div.leftMenu {position:fixed;left:-250px;top:60px;width:208px;height:calc(100vh - 60px);background:#eee;transition:all 0.5s}
div.leftMenu.menuHidden {left:-250px;transition:all 0.3s;}
div.leftMenu.menuShown {left:0px;transition:all 0.3s;}

div#searchOptions > input[type="checkbox"]+label {
    display: inline-block;
    background: #a99673;
    width: 20px;
    height: 20px;
    text-align: center;
    vertical-align: -1px;
    padding-top: 3px;
    border-radius: 15px;
    font-size: 12px;
}

.objectsList {overflow-y:auto;overflow-x:hidden;}

#searchOptions > label:nth-child(2) {
    vertical-align: -7px !important;
}
div.leftMenu >label {color:#cccccc;}
div.leftMenu hr {
    border-color: grey;
    margin: 10px 0px 10px -5px;
}
div#searchOptions > input[type="checkbox"]:checked+label {background:wheat;font-weight:bold;}


li {white-space:nowrap;}
.liSelected {background:#069;}
input[type="checkbox"] { vertical-align: -3px; }
ul {-webkit-padding-start: 1px; font-size: 11px; list-style-type: decimal; list-style-position: inside;}
ul.collapsed >li {display:none}

.expanded div  {
	color:lightgreen ;
}

#editor {
	flex:1 1 92vh;
	background: #f8f8f8;
	margin:1px 0px 1px 1px;
}

#Projet {position:relative;display:block;height:145px;width:100%;overflow:auto;}
#projectList {position: relative; display: block; margin: 0px 0 0; font-size: 12px; height: 160px; width: 200px; overflow-y: hidden; overflow-x: hidden;border-bottom:1px solid grey;}
#workList {position: relative; display: block; margin: 0px 0 0; font-size: 12px; height:180px; width: 200px; overflow: hidden;border-bottom:1px solid grey;}
#fileList {
	margin: 5px 0;
    font-size: 12px;
    width: 204px;
}
#editorMain {position: fixed; display: block; left: 0px; top:60px; width:100vw; bottom:0; background: #222;}
#editorHeader {position: absolute; display: block; left: 0px; top: 0px; width:100%; height:60px; box-shadow: 1px 1px 9px; background: #222; padding: 1px;}
#editorHeader > div, #editorHeader > div label {color:white;}
.flexCol {display:flex;flex-flow:column nowrap;}
.flexRow {display:flex;flex-flow:row nowrap;}
.flexColWrap {display:flex;flex-flow:column wrap;}
.flexRowWrap {display:flex;flex-flow:row wrap;}

input[type="radio"] {display:none;}
input[type="radio"]+label	  {
	display:inline-block;
	background: #333; 
	height: 20px; 
	color: #eee !important;
	font-style:italic;
	text-align:center;
	padding: 3px;
	border: 1px solid transparent;
	border-width: 1px 1px 1px 0px;
	border-radius: 2px;
	background-color: hsla(0,0%,100%,.09);
	background-image: linear-gradient(hsla(0,0%,100%,.05), hsla(0,0%,100%,0));
	background-clip: padding-box;
	border: 1px solid hsla(0,0%,0%,.35);
	border-color: hsla(0,0%,0%,.32) hsla(0,0%,0%,.38) hsla(0,0%,0%,.42);
	box-shadow: 0 1px 0 hsla(0,0%,0%,.05) inset, 0 1px 0 hsla(0,0%,100%,.05);
	color: hsl(0,0%,95%);
	font-size: 9px;
	line-height: 14px;
	outline-style: none;
	transition-property: background-color, border-color, box-shadow;
	transition-duration: 150ms;
	transition-timing-function: ease;
	width:50px;
}

.lblmode {
    font-size: 9px !important;
    width: 35px !important;
}

input[type="radio"]+label:hover { background:linear-gradient( #000, #555, #000); }
input[type="radio"]:checked+label{background:#d8bf90;box-shadow:1px 1px 3px #000 inset;color:black!important;border:1px solid #424242;padding:3px;height:20px;}
input.searchMode+label {width:55px !important;}

#docname {display:inline-block;width:160px;min-width:160px;}
#compiledView {position: absolute; display: none; right: 0px; top: 0; width: calc(50vw - 101px); height: 50vh; background: white; box-shadow: 1px 1px 33px grey; z-index: 9999; background: white; overflow: auto; font-size: 12px; margin-left: 8px; padding: 5px;}
#compiledView textarea {width:100%;height:100%;}
#divRenderContent {overflow:hidden;background:white;}
label {font-size:12px;color:black;font-style:italic;}
.divOff {display:none;left:-10000px;top:-1000px;height:0;width:0;overflow:hidden;}

#fnSelcodetypeapp {width:150px;height:22px;}
#fnSelcodeWoseDoc {width:150px;font-size:11px;margin-left:5px;}

#corpsWoseDoc {position:absolute;left:0;top:0px;right:0;bottom:0;}
#editorHeader > div:nth-child(2) > table > tbody > tr { line-height: 27px; }

::-webkit-scrollbar { width: 6px;height: 6px;}
::-webkit-scrollbar-track { background: rgba(0, 0, 0, 0.1); box-shadow: inset 0 0 6px rgba(0,0,0,0.3); border-radius: 10px; }
::-webkit-scrollbar-thumb { border-radius: 10px; background: rgba(0,250,0,0.8); box-shadow: inset 0 0 6px rgba(0,0,0,0.5); }
::-webkit-scrollbar-thumb:window-inactive { background: rgba(0,0, 0,0.2); }

.dsButtons img {vertical-align:-5px;width:16px;height:16px;margin:0 10px;}
.dsButtons {background: #333; height: 25px; color: #eee;font-style:italic;text-align:left;padding: 3px 6px;
  border: 1px solid transparent;
  border-width: 1px 1px 1px 0px;
  border-radius: 2px;
  background-color: hsla(0,0%,100%,.09);
  background-image: linear-gradient(hsla(0,0%,100%,.05), hsla(0,0%,100%,0));
  background-clip: padding-box;
  border: 1px solid hsla(0,0%,0%,.35);
  border-color: hsla(0,0%,0%,.32) hsla(0,0%,0%,.38) hsla(0,0%,0%,.42);
  box-shadow: 0 1px 0 hsla(0,0%,0%,.05) inset, 0 1px 0 hsla(0,0%,100%,.05);
  color: hsl(0,0%,95%);
  font-size: 12px;
  line-height: 14px;
  outline-style: none;
  transition-property: background-color, border-color, box-shadow;
  transition-duration: 150ms;
  transition-timing-function: ease;}
.dsButtons:hover { background:linear-gradient( #000, #555, #000); }

.dropdownToolbarButton > select > option { background: hsl(0,0%,24%); }
.dropdownToolbarButton { max-width:300px;border: 1px solid hsla(0,0%,0%,.35); border-color: hsla(0,0%,0%,.32) hsla(0,0%,0%,.38) hsla(0,0%,0%,.42); box-shadow: 0 1px 0 hsla(0,0%,100%,.05) inset, 0 0 1px hsla(0,0%,100%,.15) inset, 0 1px 0 hsla(0,0%,100%,.05);}
.dropdownToolbarButton:hover, .toolbarButton.textButton:hover, .toolbarButton.textButton:focus { background-color: hsla(0,0%,0%,.2); box-shadow: 0 1px 0 hsla(0,0%,100%,.05) inset, 0 0 1px hsla(0,0%,100%,.15) inset, 0 0 1px hsla(0,0%,0%,.05); z-index: 199; }
.dropdownToolbarButton select {color:#f2f2f2;background:#5f5f5f;border:1px solid transparent;outline:0;}
.toolbarField { padding: 3px 6px; margin: 4px 0 4px 0; border: 1px solid transparent; border-radius: 2px; background-color: hsla(0,0%,100%,.09); background-image: linear-gradient(hsla(0,0%,100%,.05), hsla(0,0%,100%,0)); background-clip: padding-box; border: 1px solid hsla(0,0%,0%,.35); border-color: hsla(0,0%,0%,.32) hsla(0,0%,0%,.38) hsla(0,0%,0%,.42); box-shadow: 0 1px 0 hsla(0,0%,0%,.05) inset, 0 1px 0 hsla(0,0%,100%,.05); color: hsl(0,0%,95%); font-size: 12px; line-height: 14px; outline-style: none; transition-property: background-color, border-color, box-shadow; transition-duration: 150ms; transition-timing-function: ease; }
.toolbarField:hover, .toolbarField:focus { background-color: hsla(0,0%,100%,.21); border-color: hsla(0,0%,0%,.4) hsla(0,0%,0%,.43) hsla(0,0%,0%,.45); }
.listeWose > i {float:right;margin-right:10px;}
.listeWose.cmp {color:#ff8888 !important}
.listeWose.chg {color:orange !important}

.imgLstDiv {
    display: inline-block;
    float: left;
    margin: 5px 2px;
    width: 30px;
    height: 40px;
}

.imgLstSubDiv {
    border-radius: 5px;
    background: #d0d0d0;
    height:25px;
    width:25px;
    text-align: center;
}

.imgLstAlign {
    display: inline-block;
    width: 1px;
    /* height: 55px; */
    overflow: hidden;
    font-size: 1px;
}

.imgLst {
    max-width: 20px;
    max-height: 20px;
    vertical-align: -12px;
}

.imgLstTxt {
    display: block;
    margin: 3px 0px;
    font-size: 9px;
    font-style: italic;
    width: 30px;
    text-overflow: ellipsis;
    overflow: hidden;
    word-break: keep-all;
}

#fnSelCodeDoc {width: 120px;background:black;color:white;}

.red {color:red !important;}
.green {color:lime !important;}
