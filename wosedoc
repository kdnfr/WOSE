create function "DBA"."WoseDoc"( in @CodeDoc integer default 0,in @a integer default 0 ) 
returns long varchar
begin
  declare "lHTML","lSource","lComp","lConstantes","lTestURL","lWorkList","lSQL","lSQL1","lSQL2","lSQL3","lSQL4","lSQL5","lSQL6","lSQL7","lProjets","lTemp" long varchar;
  declare "lDocName","lDocType","lInclude","lIncluder","lEditorContext","lOrigin" long varchar;
  declare "lTypeWoseDoc","lFileName","lFileType","lFileDType","lFiltreDocuments","lTableName","lsessionUID","lastCat","lColor" char(255);
  declare "la","lobk","nl","ln","lCodeDoc","lCodeDocGrp","lCodeProjet","lCount","lLength","lsqlmsg","lgfs","lOrigine","lcodeType","typeWoseDoc","lCodeProjectDescription","lBrouillon","lwo","lEditingMode","lOpenDocByUser" integer;
  set "la" = "IsNull"("http_variable"('a'),@a);
  set "lbrouillon" = "IsNull"("http_variable"('brouillon'),1);
  set "lsource" = "IsNull"("http_variable"('Source'),'');
  set "lcodedoc" = "IsNull"("http_variable"('CodeDoc'),@CodeDoc);
  set "lcodedocgrp" = "IsNull"("http_variable"('CodeDocGrp'),0);
  set "lcodeprojet" = "IsNull"("http_variable"('codeProjet'),0);
  set "ldocname" = "IsNull"("http_variable"('DocName'),'');
  set "ldoctype" = "IsNull"("http_variable"('DocType'),'');
  set "ltesturl" = "IsNull"("http_variable"('TestURL'),'');
  set "lsqlmsg" = "IsNull"("http_variable"('sqlmsg'),0);
  set "lgfs" = "IsNull"("http_variable"('gfs'),0);
  set "lorigine" = "IsNull"("http_variable"('Origine'),0);
  set "lcodetype" = "http_variable"('CodeType');
  set "ltypewosedoc" = "http_variable"('typeWoseDoc');
  set "lfilename" = "http_variable"('FileName');
  set "lfiltredocuments" = "IsNull"("http_variable"('filtreDocuments'),'');
  set "ltablename" = "IsNull"("http_variable"('tableName'),'');
  set "lobk" = "IsNull"("http_variable"('obk'),0);
  set "leditorcontext" = "IsNull"("http_variable"('editorContext'),'');
  set "lwo" = "IsNull"("http_variable"('wo'),0);
  set "leditingmode" = "IsNull"("http_variable"('editingMode'),0);
  if "VarExists"('lCodeUser') = 0 then create variable "lCodeUser" integer end if;
  if "VarExists"('sessionID') = 0 then create variable "sessionID" integer end if;
  if "VarExists"('sessionUID') = 0 then create variable "sessionUID" char(4096) end if;
  begin try
    if "lSessionUID" <> 'KDN' then
      if not("lSessionUID" in( 'BDN','KDN' ) and("lTCPIP" in( '127.0.0.1','192.168.59.70','192.168.70.10','95.169.81.97','78.227.57.13','83.152.211.8','93.29.56.86','37.169.16.191','109.190.80.248','185.204.209.110','185.204.209.111','37.169.18.56' ) or "lTCPIP" like '192.168.70.%')) then
        set "lHTML" = '<a href="./PSaccueil">Page non trouvée, cliquez pour retourner à l''accueil</a><br>' || "lSessionUID" || ' / ' || "ltcpip" || '';
        return "CSConvert"("lHTML",'UTF-8')
      end if
    end if;
    select first '<span style="font-size: 20px;font-weight:bold;color: #f9aa5a;padding:2px 10px" title="my IP: ' || "lTCPIP" || ', database : ' || "db_Property"('File') || ' (' || "db_Property"('FileSize') || ')">WOSE</span> <b>W</b>eb <b>O</b>riented <b>S</b>QL <b>E</b>ditor, "<b onclick="changeLog()">' || "sessionUID" || '</b>" <i>connected to </i> "' || "db_Property"('Alias') || '" <i>via</i> "' || "value" || '".'
      into "lOrigin"
      from "sa_http_header_info"('Origin');
    if "la" = 19000 then
      return "lOrigin"
    end if;
    if "la" = 308 then
      update "WoseDoc" as "d" join "WoseDocGrp" as "dg" on "dg"."codeDoc" = "d"."CodeDoc" join "woseProject" as "p" on "p"."codeProject" = "dg"."CodeDocGrp"
        set "d"."openDocByUser" = null
        where "codeProject" = "lCodeprojet" and "d"."openDocByUser" = "sessionUID";
      return ''
    end if;
    if "la" = 20001 then
      set "lHTML" = '';
      for "lbi" as "csi" dynamic scroll cursor for
        select * from "woseBlob" where "IsNull"("description",'') <> '' and "objType" in( 'jpeg','jpg','png','gif' ) and "len"("Objet") < 50000 order by "description" asc
      do
        set "lHTML" = "lHTML" || '<div class="imgLstDiv" onclick="javscript:openImage(' || "codeWoseBlob" || ')" title="' || "URL"
           || '" >\x0A<div class="imgLstSubDiv">\x0A<img class="imgLst" id="' || "codeWoseBlob" || '" src="' || "Objet"
           || '" />\x0A</div>\x0A<div class="imgLstTxt" >' || "SubStr"("URL","Locate"("URL",'/',-1)+1,8)
           || '</div>\x0A</div>'
      end for;
      set "lHTML"
         = '<div id="hn">\x0A<div>Available pictures :</div>\x0A<hr>\x0A' || "lHTML"
         || '\x0A</div>';
      call "dbo"."sa_set_http_header"('content-Encoding','gzip');
      return "compress"("lHTML",'gzip')
    end if;
    if "la" = 701 then
      set "lHTML" = 'nope';
      for "lbli" as "csli" dynamic scroll cursor for
        select top 10 * from "a_wosedoc" where "docend" is null and "docname" like '%' || "lDocName" || '%' order by "docname" asc
      do
        set "lHTML" = "lHTML" || '<li class="listeWose" DocType="' || "DocType" || '" search="' || "lcase"("DocName") || ' ' || "lcase"("TestURL") || '" id="lr' || "CodeDoc" || '" TestURL="' || "TestURL"
           || '"\x0Aonclick="importerMaster(' || "CodeDoc" || ', ''' || "DocName"
           || ''')"\x0Atitle="' || "DocName" || '.' || "DocType" || ' (' || "CodeDoc" || ') par ' || "IsNull"("respMaj",'') || ' (' || "IsNull"("respTCPIP",'') || ') @ ' || "DocDate"
           || '"\x0A>\x0A' || "DocName" || '.' || "docType"
           || '\x0A</li>'
      end for;
      set "lHTML" = '<ul>' || "lHTML" || '</ul>';
      return "lHTML"
    end if;
    if "la" = 702 then
      insert into "wosedoc" select * from "a_wosedoc" where "codedoc" = "lCodeDoc";
      return @@identity
    end if;
    if "la" = 10202 then
      insert into "wosedoc"( "DocDate","DocEnd","DBName","ProjName","DocType","DocName","Source" ) select "DocDate","DocEnd","DBName","ProjName","DocType","DocName","Source" from "a_wosedoc" where "codedoc" = "lCodeDoc";
      return @@identity
    end if;
    if "la" = 106 then
      select '<div id="activeDocName" style="display: inline-block;font-size: 20px;font-weight: bold;color: #f1a558;">\x0A' || "DocName"
         || '\x0A</div>\x0A<div style="display: inline-block;font-family:calibri;font-size:12px;font-weight:100;font-style:italic;margin: 0px 10px;color:wheat;vertical-align: -4px;">\x0Aversion ' || "IsNull"("Version",1) || '.' || "IsNull"("Revision",0) || ' (' || "dateformat"("DocDate",'yy-mm-dd hh:mm:ss')
         || ')\x0A<br>build : ' || "CodeDoc" || ' (len: ' || "len"("Source")
         || ')\x0A</div>\x0A<div style="float:Right;font-family:calibri;font-size:12px;font-weight:100;font-style:italic;">\x0A<button class="dsButtons" id="saveButton" onclick="saveData(202)" style="margin:1px 5px;"><img src="save.png" style="height:15px;vertical-align:-3px;margin-right:5px;"/>Save</button>\x0A<button class="dsButtons" id="compileButton" onclick="saveData(212)" style="margin:1px 5px;' || if "source" <> "brouillon" then 'color:#faacac;' endif
         || '"><img src="envoyerWhite.png" style="height:15px;vertical-align:-3px;margin-right:5px;"/>Compile</button>\x0A</div>\x0A<div style="float:right;font-family:calibri;font-size:12px;font-weight:100;font-style:italic;">\x0AVue : <input class="toolbarField" id="testURL" type="text" value="' || "TestURL"
         || '" />\x0A<button class="dsButtons" onclick="saveData(222)" style="margin:1px 5px;"><img src="save.png" style="height:15px;vertical-align:-3px;margin-right:5px;"/>Vue</button>\x0A</div>'
        into "lHTML"
        from "WoseDoc" where "CodeDoc" = "lCodeDoc";
      return "lHTML"
    elseif "la" = 107 then
      set "lHTML" = "fnsel"('Select d.codedoc code, d.docdate data From wosedoc d join wosedoc doc on doc.docname=d.docname and doc.doctype=d.doctype where doc.codedoc = ' || "lCodeDoc" || ' Order By d.DocDate desc ','codeWoseDoc',"lCodeDoc");
      return "lHTML"
    end if;
    if "la" = 390 then
      if "lEditingMode" = 1 then
        if "lCodeDoc" > 0 then
          update "woseDoc" set "openDocByUser" = "sessionUID" where "codeDoc" = "lCodeDoc" and "isnull"("openDocByUser",'') = ''
        else
          return 0
        end if
      else
        if "lCodeProjet" > 0 then
          return 0
        elseif "lCodeDoc" > 0 then
          update "woseDoc" set "openDocByUser" = null where "codeDoc" = "lCodeDoc" and "isnull"("openDocByUser",'') = "sessionUID"
        end if
      end if;
      select if "isnull"("openDocByUser",'') = '' then 0 else if "openDocByUser" = "sessionUID" then 1 else 9 endif endif into "lOpenDocByUser" from "wosedoc" where "codedoc" = "lcodedoc";
      return "lOpenDocByUser"
    end if;
    if "la" = 109 then update "WoseDoc" set "TestURL" = '' where "CodeDoc" = "lCodeDoc";
      return '' end if;
    if "la" = 11010 then return 'OK' end if;
    if "la" = 10002 then
      select "description" into "lHTML" from "woseProject" where "codeProject" = "lCodeDoc";
      return "CSConvert"("lHTML",'UTF-8')
    elseif "la" = 208 then
      select "editorContext" into "lHTML" from "WoseDoc" where "CodeDoc" = "lCodeDoc";
      return "lHTML"
    elseif "la" = 10006 then
      select "sum"("len"("IsNull"("Source",''))) into "lLength" from "WoseDoc" as "d" join "WoseDocGrp" as "dg" on "dg"."codeDoc" = "d"."CodeDoc" join "woseProject" as "p" on "p"."codeProject" = "dg"."CodeDocGrp" where "codeProject" = "lCodeDoc";
      select '<div style="float:left;">Document du projet ' || "Project"
         || ' </div>\x0A<div style="float:Right;font-family:calibri;font-size:12px;font-weight:100;font-style:italic;">\x0Agroup ' || "Project"
         || '\x0A<br>build : ' || "codeProject" || ' (len: ' || "len"("IsNull"("description",''))+"lLength"
         || ')\x0A</div>\x0A<div style="float:right;font-family:calibri;font-size:12px;font-weight:100;font-style:italic;">\x0A<button class="dsButtons" id="saveButton" onclick="saveGroupDescription(' || "lCodeDoc"
         || ')" style="margin:1px 5px;"><img src="save.png" style="height:15px;vertical-align:-3px;margin-right:5px;"/>Save</button>\x0A</div>\x0A</div>'
        into "lHTML"
        from "woseProject" where "codeProject" = "lCodeDoc";
      return "CSConvert"("lHTML",'UTF-8')
    elseif "la" = 10003 then
      update "woseProject" set "description" = "lSource" where "codeProject" = "lCodeDoc";
      return ''
    elseif "la" = 207 then
      update "WoseDoc" set "editorContext" = "lEditorContext" where "CodeDoc" = "lCodeDoc";
      return ''
    elseif "la" = 205 then
      update "WoseDoc" set "brouillon" = "lSource","editorContext" = "lEditorContext" where "CodeDoc" = "lCodeDoc";
      return @@rowcount
    end if;
    if "la" > 1 then
      if "left"("lDocName",4) <> 'wose' then
        if "la" = 501 then
          select "List"('<tr><td>' || "cName" || '</td><td>' || if "syslength" > 0 then if "coltype" in( 'numeric','decimal' ) then "coltype" || '(' || "length" || ',' || "syslength" || ')' else "coltype" || '(' || "length" || ')' endif else if "coltype" in( 'char','nchar' ) then "coltype" || '(' || "length" || ')' else "coltype" endif endif || ' ' || if "in_Primary_Key" = 'y' then 'primary key' endif || ' ' || if "IsNull"("Default_value",'') <> '' then 'Default ' || "Default_value" || '' endif || '</td></tr>','' order by "cName" asc)
            into "lHTML"
            from "sys"."syscolumns" where "tName" = "lTableName";
          select "List"("cName",', ' order by "colno" asc)
            into "lSQL"
            from "sys"."syscolumns" where "tName" = "lTableName";
          select "List"('d.' || "cname" || '=s.' || "cname",', ' order by "colno" asc)
            into "lSQL2"
            from "sys"."syscolumns" where "tName" = "lTableName";
          select "List"('d.' || "cname" || ' as s_' || "cname",', ' order by "colno" asc)
            into "lSQL3"
            from "sys"."syscolumns" where "tName" = "lTableName";
          select "List"('d.' || "cname" || '=s_' || "cname",', ' order by "colno" asc)
            into "lSQL4"
            from "sys"."syscolumns" where "tName" = "lTableName";
          select "List"('d.' || "cname" || '=s_' || "cname",' and ' order by "colno" asc)
            into "lSQL5"
            from "sys"."syscolumns" where "tName" = "lTableName";
          select "List"('d.' || "cname" || '!=s_' || "cname",' or ' order by "colno" asc)
            into "lSQL6"
            from "sys"."syscolumns" where "tName" = "lTableName";
          select 'insert into ' || "tName" || ' (' || "List"('d.' || "cname",', ' order by "colno" asc) || ') ' || "char"(10) || 'values (' || "list"('s_' || "cname",', ' order by "colno" asc) || ')'
            into "lSQL7"
            from "sys"."syscolumns" where "tName" = "lTableName" group by "tName";
          return
            '<div style="position:relative;display:block;top:10px;left:10px;width:100%;height:300px;overflow:auto;font-size:12px;cursor:pointer;">\x0A<b><i>Click on a column and paste the result with Shift-F4</i></b>\x0A<hr>\x0A<table id="sqlQueries" onclick="copyColumn()" >\x0A<tr><td colspan="2">' || "lSQL"
             || '</td></tr>\x0A<tr><td colspan="2" style="font-size: 0;padding: 0;"><hr/></td></tr>\x0A<tr><td colspan="2" >' || "lSQL2"
             || '</td></tr>\x0A<tr><td colspan="2" style="font-size: 0;padding: 0;"><hr/></td></tr>\x0A<tr><td colspan="2" >' || "lSQL3"
             || '</td></tr>\x0A<tr><td colspan="2" style="font-size: 0;padding: 0;"><hr/></td></tr>\x0A<tr><td colspan="2" >' || "lSQL4"
             || '</td></tr>\x0A<tr><td colspan="2" style="font-size: 0;padding: 0;"><hr/></td></tr>\x0A<tr><td colspan="2" >' || "lSQL5"
             || '</td></tr>\x0A<tr><td colspan="2" style="font-size: 0;padding: 0;"><hr/></td></tr>\x0A<tr><td colspan="2" >' || "lSQL6"
             || '</td></tr>\x0A<tr><td colspan="2" style="font-size: 0;padding: 0;"><hr/></td></tr>\x0A<tr><td colspan="2" >' || "lSQL7"
             || '</td></tr>\x0A<tr><td colspan="2" style="font-size: 0;padding: 0;"><hr/></td></tr>\x0A' || "lHTML"
             || '\x0A</table>\x0A<style> #sqlQueries tr td {max-width:435px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-size:11px;}\x0A</div>'
        end if;
        if "la" = 321 then
          insert into "WoseDocGrp"( "CodeDocGrp","CodeDoc" ) select "lCodeDocGrp","lCodeDoc";
          return @@rowcount
        end if;
        if "la" = 329 then
          delete from "WoseDocGrp" where "CodeDocGrp" = "lCodeDocGrp" and "CodeDoc" = "lCodeDoc";
          return @@rowcount
        end if;
        if "la" = 216 then
          select 'drop table ' || "DocName" into "lHTML" from "wosedoc" where "codeDoc" = "lCodeDoc";
          begin try
            execute immediate "lHTML"
          end try
          begin catch
            call "sqlmessage"('erreur');
            set "lTemp" = 'Code erreur : ' || "ERROR_SQLCODE"() || '<br><br>Message : ' || "ERROR_message"() || ' <br><br>Module ' || "ERROR_procedure"() || ' (' || "lLength" || ')<hr><pre>' || "STACK_TRACE"() || '</pre><hr>';
            call "sqlMessage"("lTemp");
            return "lTemp"
          end catch;
          return @@rowcount
        end if;
        if "la" in( 202,212 ) then
          if "lCodeDoc" > 0 and "lSource" <> '' then
            if(select "Source" from "WoseDoc" where "CodeDoc" = "lCodeDoc") <> "lSource" then
              insert into "WoseDoc"( "CodeParent","DocDate","DocEnd","DBName","ProjName","DocType","DocName","Source","Comp","TestURL","Version","Revision","Compilation","aliasName","openDocByUser","syncName","syncTime","Domain","compDate","inProduction","respMaj","respTCPIP" ) 
                select "lCodeDoc","DocDate","now"(),"DBName","ProjName","DocType","DocName","Source","Comp","TestURL","Version","Revision","Compilation","aliasName","openDocByUser","syncName","syncTime","Domain","compDate","inProduction","respMaj","respTCPIP"
                  from "WoseDoc" where "CodeDoc" = "lCodeDoc" and "minutes"("DocDate","now"()) < 60;
              update "WoseDoc" set "Source" = "lSource","DocDate" = "now"(),"TestURL" = "lTestURL","respMaj" = "lSessionUID","respTCPIP" = "ltCPIP" where "CodeDoc" = "lCodeDoc"
            end if
          end if;
          if "la" = 202 then return @@rowcount end if
        end if;
        if "la" = 212 then
          if "lCodeDoc" > 0 then
            if "lsqlmsg" = 1 then
              delete from "SQLMessage" where "respMSG" = "lSessionUID"
            end if;
            select "DocType" into "lDocType" from "WoseDoc" where "CodeDoc" = "lCodeDoc";
            if "lDocType" in( 'event','func','proc','serv','table','template','trig','view','w3css','w3js' ) then
              if "lDocType" in( 'func','proc','table','view' ) then
                set "lSQL" = "Left"("lSource","Locate"("lSource",'(')+1);
                set "lSQL" = "Replace"("Replace"("Replace"("Replace"("Replace"("Replace"("Replace"("Replace"("Replace"("Replace"("Replace"("Replace"("Replace"("Replace"("Replace"("lSQL","Char"(9),'.'),"Char"(13),'.'),"Char"(10),'.'),'&nbsp;','.'),' ','.'),'Create ','Create.'),'alter ','alter.'),'"',''),'''',''),'(','.('),'..','.'),'..','.'),'..','.'),'..','.'),'..','.');
                select "Locate"("lSQL",'.' || "lDocName" || '.(') into "lCount";
                if "lCount" = 0 then
                  set "lSQL" = "Left"("lSQL","Locate"("lSQL",'.as.')+10);
                  select "Locate"("lSQL",'.' || "lDocName" || '.as.') into "lCount"
                end if;
                if "lCount" = 0 then
                  set "lHTML" = 'ATTENTION : Le nom du fichier : <b>' || "lDocName" || '</b> <br><br>et le nom de l''objet :<br><b>' || "lSQL" || '</b><br><br> ne correspondent pas , veuillez corriger.';
                  return "lHTML"
                end if
              end if;
              set "lComp" = "woseCompiler"("lCodeDoc")
            else
              set "lComp" = "lSource"
            end if;
            if "Left"("Trim"("lSource"),5) in( 'creat','alter' ) then
              begin try
                execute immediate "lComp";
                update "wosedoc" set "revision" = "isnull"("revision",0)+1 where "codedoc" = "lCodeDoc";
                set "lHTML" = @@rowcount
              end try
              begin catch
                if "left"("lComp",13) = 'create table ' then
                  if "ERROR_SQLCODE"() = -110 then
                    set "lHTML" = 'La table existe déjà, voulez vous l''effacer pour la recréer : <button onclick="delRecreate()">Oui</button><button onclick="closeModalDialog()">Non</button><br>(' || "ERROR_SQLCODE"() || ', ' || "ERROR_message"() || ')'
                  else
                    set "lHTML" = 'Erreur : ' || "ERROR_SQLCODE"() || ', ' || "ERROR_message"() || '.'
                  end if;
                  return "CSConvert"("lHTML",'UTF-8')
                end if;
                set "lComp" = "Replace"("Replace"("lComp",'<','&' || 'lt;'),'>','&' || 'gt');
                set "lLength" = cast("regexp_SubStr"("Right"("ERROR_message"(),6),'[[:digit:]].*') as integer);
                set "lSQL" = '';
                if "lLength" > 3 then set "lSQL" = ("lLength"-3) || ' - ' || "fnsplit"("lComp","lLength"-3,"Char"(10)) || "Char"(10) end if;
                if "lLength" > 2 then set "lSQL" = "lSQL" || ("lLength"-2) || ' - ' || "fnsplit"("lComp","lLength"-2,"Char"(10)) || "Char"(10) end if;
                if "lLength" > 1 then set "lSQL" = "lSQL" || ("lLength"-1) || ' - ' || "fnsplit"("lComp","lLength"-1,"Char"(10)) || "Char"(10) end if;
                set "lSQL" = "lSQL" || '------------------------------' || "Char"(10) || ("lLength") || ' - ' || "fnsplit"("lComp","lLength","Char"(10)) || "Char"(10) || '------------------------------' || "Char"(10);
                set "lSQL" = "lSQL" || ("lLength"+1) || ' - ' || "fnsplit"("lComp","lLength"+1,"Char"(10)) || "Char"(10);
                set "lSQL" = "lSQL" || ("lLength"+2) || ' - ' || "fnsplit"("lComp","lLength"+2,"Char"(10)) || "Char"(10);
                set "lSQL" = "lSQL" || ("lLength"+3) || ' - ' || "fnsplit"("lComp","lLength"+3,"Char"(10)) || "Char"(10);
                set "lHTML" = 'Code erreur : ' || "ERROR_SQLCODE"() || '<br><br>Message : ' || "ERROR_message"() || ' <br><br>Module ' || "ERROR_procedure"() || ' (' || "lLength" || ')<hr><pre>' || "STACK_TRACE"() || '</pre><hr>';
                return "CSConvert"("lHTML",'UTF-8')
              end catch
            end if;
            update "WoseDoc" set "Comp" = "lComp","source" = "lSource","brouillon" = "lSource","DocDate" = "now"(),"respMaj" = "lSessionUID","respTCPIP" = "lTCPIP","compDate" = "now"() where "CodeDoc" = "lCodeDoc"
          end if;
          return @@rowcount
        elseif "la" = 222 then
          update "WoseDoc" set "TestURL" = "lTestURL" where "CodeDoc" = "lCodeDoc";
          return @@rowcount
        elseif "la" = 232 then
          select "Comp","DocType" into "lHTML","lDocType" from "WoseDoc" where "CodeDoc" = "lCodeDoc";
          if "lOrigine" = 3 then
            if "lDocType" = 'View' then
              select "source" into "lHTML" from "systable" where "table_name" = "lDocName"
            else
              select "IsNull"("proc_defn",'pas encore compilé dans sybase') into "lHTML" from "sysprocedure" where "proc_name" = "lDocName"
            end if
          elseif "lOrigine" = 2 then
            if "lDocType" = 'View' then
              select "source" into "lHTML" from "systable" where "table_name" = "lDocName"
            else
              select "IsNull"("Source",'pas de source Sybase disponible') into "lHTML" from "sysprocedure" where "proc_name" = "lDocName"
            end if
          elseif "lOrigine" = 1 then
            set "lHTML" = "woseCompiler"("lCodeDoc")
          end if;
          return "CSConvert"("lHTML",'UTF-8')
        elseif "la" = 389 then
          if(select "count"() from "WoseDoc" as "d1" join "WoseDoc" as "d2" on "d2"."DocName" = "d1"."DocName" and "d2"."DocType" = "d1"."DocType" and "d1"."DocEnd" is null and "d2"."CodeDoc" <> "d1"."CodeDoc" where "d2"."DocEnd" is null and "d2"."CodeDoc" = "lCodeDoc") = 0 then
