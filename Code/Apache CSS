* {box-sizing:border-box;}
.divHidden {position:fixed !important;display:block !important;overflow:hidden !important;left:-100px !important;top:0 !important;width:0 !important;height:0 !important;}
.abejMini { position: absolute; top: 2px; left: 2px; width: 75px; height: 30px; padding: 2px 10px; opacity: 0.99; background: white; border: grey solid 2px; border-radius: 15px; box-shadow: 0 0 6px grey inset;}
.closeButton {position: absolute;display:block; top:-3px;right:-3px; width:30px; height:30px; background: #ccc url(deleteOn.png) no-repeat 50% 50%; border-radius: 15px;}
.boxShadow {box-shadow:1px 1px 3px rgba(0,0,0,.5) !important;}
.boxHeavyShadow  {box-shadow:3px 3px 9px rgba(0,0,0,.9);}
.fixBlock {position:fixed;display:block;}
.fixNone {position:fixed;display:none;left:-10000px !important;}
.absBlock {position:absolute;display:block;}
.absNone {position:absolute;display:none;left:-10000px;}
.relInline {position:relative;display:inline-block;}

.flexCol {display:flex;flex-flow:column nowrap;}
.flexRow {display:flex;flex-flow:row nowrap;}

.flexColWrap {display:flex;flex-flow:column wrap;}
.flexRowWrap {display:flex;flex-flow:row wrap;}

.flex2Cols {width:calc(50% - 5px);padding:2px;}

.hdrButtons {background:linear-gradient(#ccc, #888);border-radius:5px;font-weight:bold;font-size:16px;color:#ccc;text-align:left;padding:8px;outline:none;border:none;}
.blackHeader {position:fixed;display:block;background:linear-gradient(#999, #555);left:0;top:0;right:0;height:40px;color:white;font-size:24px;text-shadow:2px 2px 6px #000;text-align:left;padding:5px 120px;}
.whitePaper {background:white;box-shadow:1px 1px 3px rgba(0,0,0,.5);padding:5px;}
