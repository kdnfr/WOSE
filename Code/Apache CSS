::-webkit-scrollbar { width: 6px; /* for vertical scrollbars */ height: 6px; /* for horizontal scrollbars */ }

::-webkit-scrollbar-track { background: rgba(0, 0, 0, 0.1); box-shadow: inset 0 0 6px rgba(0,0,0,0.3); border-radius: 10px; }

::-webkit-scrollbar-thumb { border-radius: 10px; background: rgba(0,250,0,0.8); box-shadow: inset 0 0 6px rgba(0,0,0,0.5); }

::-webkit-scrollbar-thumb:window-inactive { background: rgba(0,0,0,0.2); }

