table.tableListe {table-layout:fixed;}

table.tableListe {width:100%;border-spacing: 10px;border-collapse: collapse;border:0;font-fammily:arial,verdana,calibri;font-size:12px;}
table.tableListe th {background:#002288;color:white;}
table.tableListe tr:nth-child(odd) td {background:#eeeeee;}
table.tableListe tr:nth-child(even) td {background:white;}
table.tableListe tr td, table.tableListe tr th {border:1px white solid;border-width:1px 1px 0 0;}

table.tableListe tr.selected td {background:rgba(44,255,200,0.6)}
table.tableListe tr td {cursor:pointer;}
table.tableListe tr td:hover {background:rgba(44,255,200,0.3)}
table.tableListe tr th:hover{background:rgba(44,255,200,0.3);color:black;}

table.tableForm {table-layout:fixed;width:100%;border-spacing: 10px;border-collapse: collapse;border:0;font-fammily:arial,verdana,calibri;font-size:12px;}

table.tableForm tr td:hover {background:rgba(44,255,200,0.3)}

table.tableForm th {background: #676767;color: white;}

table.tableForm th:hover {background: #474747;color: white;}

#__modalDialogBox { position:fixed;display:block;left:0px;right:0px; bottom:0px;background:rgba(44,44,44,0.4); transition:all .3s ease-in-out;text-align:center;box-shadow:0 0 50px #555;font-size:14px;font-family: "proxima-nova","Helvetica Neue","Helvetica","sans-serif";}
#__modalDialogBox { color: #090594; }
#modalDialogContent {margin:10px 20px;}
#modalDialogFooter {padding: 15px; text-align: right; border-top: 1px solid #e5e5e5;margin-bottom: 0;margin-left: 5px;}
#modalDialogHeader {position: relative; width:500px;background-color: #fff; background-clip: padding-box; border: 1px solid rgba(0,0,0,.2); border-radius: 6px; outline: 0;margin: 100px calc(50% - 250px);text-align:left;box-shadow:0 0 50px #555;z-index:2010;}
#modalDialogHeader button {width:80px;height:22px;margin:10px;}
.mdbHide {top:-200px;max-height:0px;z-index:2010;opacity:0;overflow:hidden;}
.mdbShow {top:0px;z-index:999999;opacity:1;}


.__dlButtons {
    min-width: 16px;
    padding: 2px 6px 0;
    border-radius: 2px;
    color: hsla(0,0%,100%,.8);
    font-size: 12px;
    line-height: 14px;
    user-select: none;
    cursor: default;
    transition-property: background-color, border-color, box-shadow;
    transition-duration: 150ms;
    transition-timing-function: ease;
    outline: none;
    background: none;
    width: 32px;
    height: 29px;
    border: 1px solid hsla(0, 0%, 0%, 0);
    float: left;
}

#__loadingbar {
    position: absolute;
    top: 32px;
    left:0;
    width: 100%;
    height: 4px;
    background-color: #333;
    border-bottom: 1px solid #333;
}

#__findPanel {
    position: absolute;
    display: block;
    left: 82px;
    top: 6px;
    width: 100%;
    color: wheat;
    font-size: 12px;
}

#findCount {
    width: 25px !important;
    text-align: left !important;
    text-overflow: clip;
}

input#__findField {
    width: 15vw;
    max-width: 400px;
    overflow: hidden;
    text-overflow: hidden;
    margin: 0;
}

#__topToolbarPanel {
    position: fixed;
    display: block;
    left: 0px;
    top: 0px;
    right: 0px;
    height: 32px;
    overflow: hidden;
    background-color: #474747;
    background-image: url(images/texture.png), linear-gradient(hsla(0,0%,32%,.99), hsla(0,0%,27%,.95));
}

#__toolbarViewerRight {
    position: absolute;
    top: 0;
    right: 5px;
}

.__toolbarField {
    width: 170px;
    background: #5f5f5f;
    border: 1px #8c8c8c solid;
    padding: 5px;
    font-size: 12px;
    height: 20px;
    color: white;
}

.__topRightPanelButtons {
    float: right;
    margin: 5px 10px;
    width: 15px;
    height: 15px;
}

.__secondaryToolbar {
    top: 32px;
    position: absolute;
    z-index: 10000;
    height: 32px;
    min-width: 16px;
    padding: 0px 6px 0px 6px;
    margin: 4px 2px 4px 2px;
    color: hsl(0,0%,85%);
    font-size: 12px;
    line-height: 14px;
    text-align: left;
    cursor: default;
}

