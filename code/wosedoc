create function "dba"."wosedoc"( in @CodeDoc integer default 0,in @a integer default 0 ) 
returns long varchar
begin
  declare "lHTML","lSource","lComp","lConstantes","lTestURL","lWorkList","lSQL","lSQL1","lSQL2","lSQL3","lSQL4","lSQL5","lSQL6","lSQL7","lProjets","lTemp" long varchar;
  declare "lDocName","lDocType","lInclude","lIncluder","lEditorContext","lOrigin" long varchar;
  declare "lTypeWoseDoc","lFileName","lFileType","lFileDType","lFiltreDocuments","lTableName","lsessionUID","lastCat","lColor","lInProdColor" char(255);
  declare "la","lobk","nl","ln","lCodeDoc","lCodeDocGrp","lCodeProjet","lCount","lLength","lsqlmsg","lgfs","lOrigine","lcodeType","typeWoseDoc","lCodOption" integer;
  declare "lCodeProjectDescription","lBrouillon","lwo","lEditingMode","lOpenDocByUser","lInProduction","lWithStructure" integer;
  set "la" = "IsNull"("http_variable"('a'),@a);
  set "lbrouillon" = "IsNull"("http_variable"('brouillon'),1);
  set "lsource" = "IsNull"("http_variable"('Source'),'');
  set "lcodedoc" = "IsNull"("http_variable"('CodeDoc'),@CodeDoc);
  set "lcodedocgrp" = "IsNull"("http_variable"('CodeDocGrp'),0);
  set "lcodeprojet" = "IsNull"("http_variable"('codeProjet'),0);
  set "ldocname" = "IsNull"("http_variable"('DocName'),'');
  set "ldoctype" = "IsNull"("http_variable"('DocType'),'');
  set "ltesturl" = "IsNull"("http_variable"('TestURL'),'');
  set "lsqlmsg" = "IsNull"("http_variable"('sqlmsg'),0);
  set "lgfs" = "IsNull"("http_variable"('gfs'),0);
  set "lorigine" = "IsNull"("http_variable"('Origine'),0);
  set "lcodetype" = "http_variable"('CodeType');
  set "ltypewosedoc" = "http_variable"('typeWoseDoc');
  set "lfilename" = "http_variable"('FileName');
  set "lfiltredocuments" = "IsNull"("http_variable"('filtreDocuments'),'');
  set "ltablename" = "IsNull"("http_variable"('tableName'),'');
  set "lobk" = "IsNull"("http_variable"('obk'),0);
  set "leditorcontext" = "IsNull"("http_variable"('editorContext'),'');
  set "lwo" = "IsNull"("http_variable"('wo'),0);
  set "leditingmode" = "IsNull"("http_variable"('editingMode'),0);
  set "linproduction" = "IsNull"("http_variable"('inProduction'),-1);
  set "lwithstructure" = "IsNull"("http_variable"('withStructure'),0);
  if "VarExists"('lCodeUser') = 0 then create variable "lCodeUser" integer end if;
  if "VarExists"('sessionID') = 0 then create variable "sessionID" integer end if;
  if "VarExists"('sessionUID') = 0 then create variable "sessionUID" char(4096) end if;
  begin try
    select "codOption","isnull"("optValue",0),"opt1" into "lCodOption","lInProduction","lInProdColor" from "weboptions" where "optionName" = 'woseDocInProduction';
    if "isnull"("lCodOption",0) = 0 then
      insert into "webOptions"( "optionName","optValue","opt1" ) select 'woseDocInProduction',0,'#aaaaaa';
      select "isnull"("optValue",0),"opt1" into "lInProduction","lInProdColor" from "weboptions" where "optionName" = 'woseDocInProduction'
    end if
  end try
  begin catch
  end catch;
  begin try
    select first '<span style="font-size: 20px;font-weight:bold;color: #66b4f7;padding:2px 10px" title="my IP: ' || "lTCPIP" || ', database : ' || "db_Property"('File') || ' (' || "db_Property"('FileSize') || ')">WOSE</span> <b>W</b>eb <b>O</b>riented <b>S</b>QL <b>E</b>ditor, "<b onclick="changeLog()">' || "sessionUID" || '</b>" <i>connected to </i> "' || "db_Property"('Alias') || '" <i>via</i> "' || "value" || '".'
      into "lOrigin"
      from "sa_http_header_info"('Origin');
    if "la" = 19000 then
      return "lOrigin"
    elseif "la" = 308 then
      update "WoseDoc" as "d" join "WoseDocGrp" as "dg" on "dg"."codeDoc" = "d"."CodeDoc" join "woseProject" as "p" on "p"."codeProject" = "dg"."CodeDocGrp"
        set "d"."openDocByUser" = null
        where "codeProject" = "lCodeprojet" and "d"."openDocByUser" = "sessionUID";
      commit work;
      return ''
    elseif "la" = 24000 then
      delete from "WoseDocGrp" where "codedocgrp" = "lcodeDoc";
      delete from "WoseProject" where "codeProject" = "lcodeDoc";
      commit work;
      return @@rowcount
    elseif "la" = 24001 then
      update "wosedoc" as "w" join "WoseDocGrp" as "dg" set "w"."InProduction" = 10 where "codedocgrp" = "lcodeDoc";
      commit work;
      return @@rowcount
    elseif "la" = 24002 then
      delete from "WoseDocGrp" where "codedocgrp" = "lcodeDoc";
      commit work;
      return @@rowcount
    elseif "la" = 24003 then
      if(select "count"()-"sum"(if "isnull"("openDocByUser",'') <> '' then 1 else 0 endif) as "nbu" from "WoseDocGrp" as "dg" left outer join "wosedoc" as "w" where "codedocgrp" = "lcodeDoc") = 0 then
        update "wosedoc" as "w" join "WoseDocGrp" as "dg" set "w"."openDocByUser" = '' where "codedocgrp" = "lcodeDoc"
      else
        update "wosedoc" as "w" join "WoseDocGrp" as "dg" set "w"."openDocByUser" = "sessionUID" where "codedocgrp" = "lcodeDoc"
      end if;
      commit work;
      return @@rowcount
    elseif "la" = 20001 then
      set "lHTML" = '';
      for "lbi" as "csi" dynamic scroll cursor for
        select * from "woseBlob" where "IsNull"("description",'') <> '' and "objType" in( 'jpeg','jpg','png','gif' ) and "len"("Objet") < 50000 and "left"("objet",5) = 'data:' order by "description" asc
      do
        set "lHTML" = "lHTML" || '<div class="imgLstDiv" search="' || "lcase"("url") || '" onclick="openImage(' || "codeWoseBlob" || ')" title="' || "URL"
           || '" >\x0A<div class="imgLstSubDiv">\x0A<img class="imgLst" id="' || "codeWoseBlob" || '" name="' || "URL" || '" src="' || "Objet"
           || '" />\x0A</div>\x0A</div>'
      end for;
      set "lHTML"
         = '<div id="hn">\x0A<div>Available pictures :</div>\x0A<hr>\x0A' || "csconvert"("lHTML",'utf-8')
         || '\x0A</div>';
      call "dbo"."sa_set_http_header"('content-Encoding','gzip');
      return "compress"("lHTML",'gzip')
    elseif "la" = 701 then
      set "lHTML" = 'nope';
      for "lbli" as "csli" dynamic scroll cursor for
        select top 10 * from "r_wosedoc" where "docend" is null and "docname" like '%' || "lDocName" || '%' order by "docname" asc
      do
        set "lHTML" = "lHTML" || '<li class="listeWose" DocType="' || "DocType" || '" search="' || "lcase"("DocName") || ' ' || "lcase"("TestURL") || '" id="lr' || "CodeDoc" || '" TestURL="' || "TestURL"
           || '"\x0Aonclick="importerMaster(' || "CodeDoc" || ', ''' || "DocName"
           || ''')"\x0Atitle="' || "DocName" || '.' || "DocType" || ' (' || "CodeDoc" || ') par ' || "IsNull"("respMaj",'') || ' (' || "IsNull"("respTCPIP",'') || ') @ ' || "DocDate"
           || '"\x0A>\x0A' || "DocName" || '.' || "docType"
           || '\x0A</li>'
      end for;
      set "lHTML" = '<ul>' || "lHTML" || '</ul>';
      return "lHTML"
    elseif "la" = 702 then
      insert into "wosedoc" select * from "r_wosedoc" where "codedoc" = "lCodeDoc";
      commit work;
      return @@identity
    elseif "la" = 10202 then
      insert into "wosedoc"( "DocDate","DocEnd","DBName","ProjName","DocType","DocName","Source" ) select "DocDate","DocEnd","DBName","ProjName","DocType","DocName","Source" from "r_wosedoc" where "codedoc" = "lCodeDoc";
      commit work;
      return @@identity
    elseif "la" = 711 then
      insert into "woseBlob"( "URL","description","categorie","objType","objSize","Objet" ) select "URL","description","categorie","objType","objSize","Objet" from "r_woseBlob" where "codeWoseBlob" = "lCodeDoc";
      commit work;
      return @@identity
    elseif "la" = 106 then
      select '<div id="activeDocName" style="display: inline-block;font-size: 20px;font-weight: bold;color: red;">\x0A' || "DocName"
         || '\x0A</div>\x0A<div style="display: inline-block;font-family:calibri;font-size:12px;font-weight:100;font-style:italic;margin: 0px 10px;color:wheat;vertical-align: -4px;">\x0AV.' || "IsNull"("Version",1) || '.' || "IsNull"("Revision",0) || ' (' || "dateformat"("DocDate",'yy-mm-dd hh:mm:ss')
         || ')\x0A<br>build : ' || "CodeDoc" || ' (len: ' || "len"("Source")
         || ')\x0A</div>\x0A<div style="float:Right;font-family:calibri;font-size:12px;font-weight:100;font-style:italic;margin: 2px 0 0 3px;">\x0A<button class="dsButtons" id="saveButton" onclick="saveData(202)" title="Save data without compiling"><img src="save.png" style="height:15px;vertical-align:-3px;margin:0;"/></button>\x0A<button class="dsButtons" title="Save and Compile data (F9)" id="compileButton" onclick="saveData(212)" style="' || if "source" <> "brouillon" then 'background:#aa4444;' endif
         || '"><img src="envoyerWhite.png" style="height:15px;vertical-align:-3px;margin:0;"/></button>\x0A<button class="dsButtons" style="width: 25px;padding: 0;margin-left: -3px;"> <img src="page.gif" style="top: 7px;height: 20px;margin-right: 14px;" onclick="getCompiled(' || "codedoc"
         || ')"></button>\x0A</div>\x0A<div style="float:right;font-family:calibri;font-size:12px;font-weight:100;font-style:italic;">\x0AVue <input autocomplete="off" class="toolbarField" id="testURL" type="text" value="' || "TestURL"
         || '" />\x0A<button class="dsButtons" onclick="saveData(222)" title="Default view in rendering form"><img src="syncWhiter.png" style="height:15px;vertical-align:-3px;margin:0;"/></button>\x0A</div>'
        into "lHTML"
        from "WoseDoc" where "CodeDoc" = "lCodeDoc";
      return "lHTML"
    elseif "la" = 107 then
      set "lHTML" = "fnsel"('Select d.codedoc code, d.docdate data From wosedoc d join wosedoc doc on doc.docname=d.docname and doc.doctype=d.doctype where doc.codedoc = ' || "lCodeDoc" || ' Order By d.DocDate desc ','codeWoseDoc',"lCodeDoc");
      return "lHTML"
    elseif "la" = 390 then
      if "isnull"("lEditingMode",0) = 1 then
        if "lCodeDoc" > 0 then
          update "woseDoc" set "openDocByUser" = "sessionUID" where "codeDoc" = "lCodeDoc" and "isnull"("openDocByUser",'') = '';
          update "woseDoc" set "openDocByUser" = "sessionUID" where "codeDoc" = "lCodeDoc" and("isnull"("openDocByUser",'') = '' or "hours"("docdate","today"()) > 1)
        else
          return 0
        end if
      else
        if "lCodeProjet" > 0 then
          return 0
        elseif "lCodeDoc" > 0 then
          update "woseDoc" set "openDocByUser" = null where "codeDoc" = "lCodeDoc" and "isnull"("openDocByUser",'') = "sessionUID"
        end if
      end if;
      select "isnull"(if "isnull"("openDocByUser",'') = '' then 0 else if "isnull"("openDocByUser",'') = "sessionUID" then 1 else 9 endif endif,1) into "lOpenDocByUser" from "wosedoc" where "codedoc" = "lcodedoc";
      commit work;
      return "lOpenDocByUser"
    end if;
    if "la" = 109 then update "WoseDoc" set "TestURL" = '' where "CodeDoc" = "lCodeDoc";
      return 'URL de test enlevé' end if;
    if "la" = 1099 then
      select "docName","comp" into "lSQL","lComp" from "wosedoc" where "codedoc" = "lcodedoc" and "locate"("comp",'materialized') > 1;
      if "isnull"("lSQL",'') <> '' then
        begin try
          execute immediate 'drop view ' || "lSQL" || ' '
        end try
        begin catch
          call "sqlmessage"('error')
        end catch;
        execute immediate "lComp";
        update "wosedoc" set "revision" = "isnull"("revision",0)+1 where "codedoc" = "lCodeDoc";
        execute immediate 'refresh MATERIALIZED view ' || "lsql" || ' ';
        set "lHTML" = @@rowcount
      else
        call "sqlMessage"('error on ' || "lSQL")
      end if;
      commit work;
      return 'Vue rafraichie'
    end if;
    if "la" = 11010 then
      return 'OK'
    elseif "la" = 10002 then
      select "description" into "lHTML" from "woseProject" where "codeProject" = "lCodeDoc";
      return "CSConvert"("lHTML",'UTF-8')
    elseif "la" = 208 then
      select "editorContext" into "lHTML" from "WoseDoc" where "CodeDoc" = "lCodeDoc";
      return "lHTML"
    elseif "la" = 10006 then
      select "sum"("len"("IsNull"("Source",''))) into "lLength" from "WoseDoc" as "d" join "WoseDocGrp" as "dg" on "dg"."codeDoc" = "d"."CodeDoc" join "woseProject" as "p" on "p"."codeProject" = "dg"."CodeDocGrp" where "codeProject" = "lCodeDoc";
      select '<div style="float:left;">Document du projet ' || "Project"
         || ' </div>\x0A<div style="float:Right;font-family:calibri;font-size:12px;font-weight:100;font-style:italic;">\x0Agroup ' || "Project"
         || '\x0A<br>build : ' || "codeProject" || ' (len: ' || "len"("IsNull"("description",''))+"lLength"
         || ')\x0A</div>\x0A<div style="float:right;font-family:calibri;font-size:12px;font-weight:100;font-style:italic;">\x0A<button class="dsButtons" id="saveButton" onclick="saveGroupDescription(' || "lCodeDoc"
         || ')"><img src="save.png" style="height:15px;vertical-align:-3px;margin-right:5px;"/>Save</button>\x0A</div>\x0A</div>'
        into "lHTML"
        from "woseProject" where "codeProject" = "lCodeDoc";
      return "CSConvert"("lHTML",'UTF-8')
    elseif "la" = 10003 then
      update "woseProject" set "description" = "lSource" where "codeProject" = "lCodeDoc";
      commit work;
      return ''
    elseif "la" = 207 then
      update "WoseDoc" set "editorContext" = "lEditorContext" where "CodeDoc" = "lCodeDoc";
      commit work;
      return ''
    elseif "la" = 205 then
      update "WoseDoc" set "brouillon" = "lSource","editorContext" = "lEditorContext" where "CodeDoc" = "lCodeDoc";
      commit work;
      return @@rowcount
    end if;
    if "la" > 1 then
      if "left"("lDocName",4) <> 'wxyz' then
        if "la" = 501 then
          call "sqlMessage"('@@lTableName weboptions = ' || "lTableName");
          return "fnFindInstanceInWosedoc"("lTableName");
          return '';
          set "lHTML" = "fnFindInstanceInWosedoc"("lTableName");
          return
            '<div style="position:relative;display:block;top:10px;left:10px;width:98%;height:320px;overflow-x:hidden;overflow-y:auto;font-size:12px;cursor:pointer;">\x0A<b><i>Results in FUNCTIONS, PROCEDURES, CONSTANTS, CSS and JAVASCRIPT for ' || "lTableName"
             || '</i></b>\x0A' || "lHTML"
             || '\x0A<style> #sqlQueries {width:100%;} #sqlQueries * {height:18px;} #sqlQueries tr td {max-width:33%;width:33%;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-size:11px;}</style>\x0A</div>';
          return "lHTML";
          select "count"() as "nb",
            '<table id="tableFunctions" class="tableForm"><tr><td>' || "pss_sys_table"("lTableName",1) || '</td></tr>'
             || '<tr><td>' || "List"("cName",', ' order by "colno" asc) || '</td></tr>'
             || '<tr><td>set lHTML = lHTML || ''&lt;tr&gt;' || "List"('&lt;td&gt;&lt;%' || "cname" || '%&gt;&lt;/td&gt;','' order by "colno" asc) || '&gt;/tr&lt;'' ;</td></tr>'
             || '<tr><td>set lHTML = ''&lt;table id="tbl_' || "lcase"("tName") || '" cla' || 'ss="tableListe"&gt&lt;tr&gt;' || "List"('&lt;th&gt;' || "replace"("pcase"("cname"),'_','&lt;br&gt;') || '&lt;/th&gt;','' order by "colno" asc) || '&lt;/tr&gt;&lt;%lHTML%&gt;&lt;/table&gt;'' ;</td></tr>'
             || '<tr><td>insert into ' || "tName" || ' (' || "List"('d.' || "cname",', ' order by "colno" asc) || ') ' || "char"(10) || 'values (' || "list"('s_' || "cname",', ' order by "colno" asc) || ')</td></tr></table>' as "html"
            into "lCount","lHTML"
            from "sys"."syscolumns" where "tName" = "lTableName"
            group by "tname";
          if "lCount" > 0 then
            set "lHTML"
               = '<div style="position:relative;display:block;top:10px;left:10px;width:98%;height:320px;overflow-x:hidden;overflow-y:auto;font-size:12px;cursor:pointer;">\x0A<b><i>Table functions for ' || "lTableName"
               || '</i></b>\x0A' || "lHTML"
               || '\x0A<style>\x0A#sqlQueries {width:100%;} #sqlQueries * {height:18px;} #sqlQueries tr td {max-width:33%;width:33%;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-size:11px;}\x0A#tableFunctions {width:100%;height:auto;}\x0A#tableFunctions td {text-align: left;white-space: nowrap;text-overflow: ellipsis;overflow: hidden;padding: 6px;border: 1px solid grey;border-width: 1px 0 0 0;}\x0A</style>\x0A</div>';
            return "lHTML"
          end if;
          select "count"(),
            "List"(
            '<tr>\x0A<td>\x0A' || "cName"
             || '\x0A</td>\x0A<td>\x0A' || if "syslength" > 0 then if "coltype" in( 'numeric','decimal' ) then "coltype" || '(' || "length" || ',' || "syslength" || ')' else "coltype" || '(' || "length" || ')' endif else if "coltype" in( 'char','nchar' ) then '' || "coltype" || '(' || "length" || ')' else "coltype" endif endif || ' ' || if "in_Primary_Key" = 'y' then 'primary key' endif || ' ' || if "IsNull"("Default_value",'') <> '' then 'Default ' || "Default_value" || '' endif
             || '\x0A</td>\x0A</tr>','' order by "cName" asc)
            into "lCount","lHTML"
            from "sys"."syscolumns" where "tName" = "lTableName";
          if "lCount" = 0 then
            select "codOption","optValue","opt2","opt3","opt4","opt7" into "lCount","lSQL","lSQL2","lSQL3","lSQL4","lSQL7" from "weboptions" where "optionName" = 'F4-Help' and "Opt1" = "lTableName";
            if "lcount" > 0 then
              return
                '<div style="position:relative;display:block;top:10px;left:10px;width:98%;height:195px;overflow-x:hidden;overflow-y:auto;font-size:12px;cursor:pointer;">\x0A<b><i>Click on a column and paste the result with Shift-F4</i></b>\x0A<hr>\x0A<table id="sqlQueries" onclick="copyColumn()" class="tableListe" style="width:100%;">\x0A<tr><td colspan="2">' || "lSQL"
                 || '</td></tr>\x0A<tr><td colspan="2" >' || "lSQL2"
                 || '</td></tr>\x0A<tr><td colspan="2" >' || "lSQL3"
                 || '</td></tr>\x0A<tr><td colspan="2" >' || "lSQL4"
                 || '</td></tr>\x0A<tr><td colspan="2" >' || "lSQL7"
                 || '</td></tr>\x0A' || "lHTML"
                 || '\x0A</table>\x0A<style>\x0A#sqlQueries {width:100%;}\x0A#sqlQueries * {height:18px;}\x0A#sqlQueries tr td {max-width:50%;width:50%;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-size:11px;}\x0A</style>\x0A</div>'
            else
              set "lHTML" = "fnFindInstanceInWosedoc"("lTableName");
              return
                '<div style="position:relative;display:block;top:10px;left:10px;width:98%;height:320px;overflow-x:hidden;overflow-y:auto;font-size:12px;cursor:pointer;">\x0A<b><i>Results in FUNCTIONS, PROCEDURES, CONSTANTS, CSS and JAVASCRIPT for ' || "lTableName"
                 || '</i></b>\x0A' || "lHTML"
                 || '\x0A<style> #sqlQueries {width:100%;} #sqlQueries * {height:18px;} #sqlQueries tr td {max-width:33%;width:33%;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-size:11px;}</style>\x0A</div>'
            end if
          else
            select "List"("cName",', ' order by "colno" asc)
              into "lSQL"
              from "sys"."syscolumns" where "tName" = "lTableName";
            select 'set lHTML = lHTML || ''&lt;tr&gt;' || "List"('&lt;td&gt;&lt;%' || "cname" || '%&gt;&lt;/td&gt;','' order by "colno" asc) || '&gt;/tr&lt;'' ;'
              into "lSQL2"
              from "sys"."syscolumns" where "tName" = "lTableName";
            select 'set lHTML = ''&lt;table id="tbl_' || "lcase"("tName") || '" cla' || 'ss="tableListe"&gt&lt;tr&gt;' || "List"('&lt;th&gt;' || "replace"("pcase"("cname"),'_','&lt;br&gt;') || '&lt;/th&gt;','' order by "colno" asc) || '&lt;/tr&gt;&lt;%lHTML%&gt;&lt;/table&gt;'' ;'
              into "lSQL3"
              from "sys"."syscolumns" where "tName" = "lTableName" group by "tname";
            select "pss_sys_table"("lTableName",1)
              into "lSQL4";
            select 'insert into ' || "tName" || ' (' || "List"('d.' || "cname",', ' order by "colno" asc) || ') ' || "char"(10) || 'values (' || "list"('s_' || "cname",', ' order by "colno" asc) || ')'
              into "lSQL7"
              from "sys"."syscolumns" where "tName" = "lTableName" group by "tName"
          end if;
          return
            '<div style="position:relative;display:block;top:10px;left:10px;width:98%;height:300px;overflow-x:hidden;overflow-y:auto;font-size:12px;cursor:pointer;">\x0A<b><i>Click on a column and paste the result with Shift-F4</i></b>\x0A<hr>\x0A<table id="sqlQueries" onclick="copyColumn()" >\x0A<tr><td colspan="2">' || "lSQL"
             || '</td></tr>\x0A<tr><td colspan="2" style="font-size: 0;padding: 0;"><hr/></td></tr>\x0A<tr><td colspan="2" >' || "lSQL2"
             || '</td></tr>\x0A<tr><td colspan="2" style="font-size: 0;padding: 0;"><hr/></td></tr>\x0A<tr><td colspan="2" >' || "lSQL3"
             || '</td></tr>\x0A<tr><td colspan="2" style="font-size: 0;padding: 0;"><hr/></td></tr>\x0A<tr><td colspan="2" >' || "lSQL4"
             || '</td></tr>\x0A<tr><td colspan="2" style="font-size: 0;padding: 0;"><hr/></td></tr>\x0A<tr><td colspan="2" >' || "lSQL7"
